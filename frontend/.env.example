# Copy to .env and fill in.

# The API base, including /api.
VITE_API_URL=http://localhost:3000/api

# Optional. Leave blank and the online-payment path is hidden rather than
# crashing — loadStripe() used to run at module scope with whatever this
# happened to be, throwing an unhandled rejection on EVERY page load when unset.
VITE_STRIPE_PUBLISHABLE_KEY=
