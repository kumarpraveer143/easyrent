# Copy to .env and fill in. A fresh clone could not boot before this file
# existed: the README documented MONGODB while the code reads MONGO_DB_URL, and
# seven other required variables were undocumented entirely.

# --- core -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Must be a REPLICA SET — B09 wraps multi-document writes (accept a tenant,
# archive a tenancy) in transactions, and a standalone mongod cannot run them.
#   docker run -d --name easyrent-mongo -p 27018:27017 mongo:7 --replSet rs0 --bind_ip_all
#   docker exec easyrent-mongo mongosh --quiet --eval 'rs.initiate({_id:"rs0",members:[{_id:0,host:"localhost:27017"}]})'
MONGO_DB_URL=mongodb://localhost:27018/easyrent?replicaSet=rs0&directConnection=true

# Sign your own. Anything that has ever been pasted into a shell or a log is
# already compromised — generate a new one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=
JWT_Expire=7d

# Used for CORS, the socket origin allowlist, and Stripe redirect URLs.
FRONTEND_URL=http://localhost:5173

# --- Stripe -----------------------------------------------------------------
# Leave blank in development and the payment path stays disabled rather than
# crashing. STRIPE_WEBHOOK_SECRET is REQUIRED for payments to be recorded at
# all — the webhook is the single writer of payment history.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- mail -------------------------------------------------------------------
# Note the spelling: SMPT, not SMTP. Kept as-is to match the code.
SMPT_SERVICE=
RENTERS_SMPT_MAIL=
RENTERS_SMPT_MAIL_PASSWORD=
